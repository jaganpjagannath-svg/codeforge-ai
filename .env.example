# CodeForge AI - Environment Configuration Example
# Copy this file to .env and fill in your values

# Google Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (SQLite locally, PostgreSQL on Render)
# For Render PostgreSQL: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///backend/codemind.db

# JWT & Security Secret Key
SECRET_KEY=change_this_to_a_random_secure_secret_key_in_production

# Code Execution Sandbox Limits
DEFAULT_TIMEOUT_SECONDS=5
MAX_MEMORY_MB=128

# Production Port (assigned dynamically by Render)
PORT=8000
